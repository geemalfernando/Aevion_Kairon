{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Kairon GitHub Actions deployer: an IAM user that can push one ECR repository and update one application stack through a CloudFormation-only execution role. The organization policy blocks GitHub OIDC providers, so CI uses this user's access key.",
  "Parameters": {
    "ApplicationStack": {
      "Type": "String",
      "Default": "kairon-rds-staging",
      "AllowedPattern": "^[A-Za-z][A-Za-z0-9-]{0,127}$"
    },
    "RepositoryName": {
      "Type": "String",
      "Description": "ECR repository from the application stack's RepositoryUri output (the part after the slash)."
    }
  },
  "Resources": {
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Assumed only by CloudFormation to apply the Kairon application template",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "cloudformation.amazonaws.com"},
              "Action": "sts:AssumeRole",
              "Condition": {"StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}}}
            }
          ]
        },
        "ManagedPolicyArns": ["arn:aws:iam::aws:policy/AdministratorAccess"]
      }
    },
    "Deployer": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "Policies": [
          {
            "PolicyName": "kairon-deploy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "UpdateApplicationStack",
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:DescribeStackResources",
                    "cloudformation:GetTemplateSummary",
                    "cloudformation:CreateChangeSet",
                    "cloudformation:DescribeChangeSet",
                    "cloudformation:ExecuteChangeSet",
                    "cloudformation:DeleteChangeSet",
                    "cloudformation:ListChangeSets"
                  ],
                  "Resource": {"Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${ApplicationStack}/*"}
                },
                {
                  "Sid": "TemplateChecksAndLookups",
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:ValidateTemplate",
                    "rds:DescribeDBEngineVersions",
                    "ec2:DescribeManagedPrefixLists",
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "PassOnlyToCloudFormation",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {"Fn::GetAtt": ["ExecutionRole", "Arn"]},
                  "Condition": {"StringEquals": {"iam:PassedToService": "cloudformation.amazonaws.com"}}
                },
                {
                  "Sid": "PushApplicationImage",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage"
                  ],
                  "Resource": {"Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/${RepositoryName}"}
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeployerUserName": {"Value": {"Ref": "Deployer"}},
    "ExecutionRoleArn": {"Value": {"Fn::GetAtt": ["ExecutionRole", "Arn"]}}
  }
}
