{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Kairon continuous deployment inside AWS: a CodeBuild project that releases main to the application stack on every push, through a GitHub connection. Deploy with ConnectionReady=false, approve the pending connection in the console, then update with ConnectionReady=true.",
  "Parameters": {
    "ConnectionReady": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Set to true after the GitHub connection shows Available in the console."
    },
    "Repository": {
      "Type": "String",
      "Default": "https://github.com/geemalfernando/Kairon.git"
    },
    "Branch": {
      "Type": "String",
      "Default": "main"
    },
    "ApplicationStack": {
      "Type": "String",
      "Default": "kairon-rds-staging",
      "AllowedPattern": "^[A-Za-z][A-Za-z0-9-]{0,127}$"
    },
    "RepositoryName": {
      "Type": "String",
      "Description": "ECR repository from the application stack's RepositoryUri output (the part after the slash)."
    },
    "ExecutionRoleArn": {
      "Type": "String",
      "Description": "CloudFormation execution role (ExecutionRoleArn output of the kairon-github-deploy stack)."
    },
    "AutoDeploy": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Start a build on every push to the branch (needs the AWS Connector for GitHub app installed on the repository)."
    }
  },
  "Conditions": {
    "Ready": {
      "Fn::Equals": [
        {
          "Ref": "ConnectionReady"
        },
        "true"
      ]
    },
    "Auto": {
      "Fn::And": [
        {
          "Condition": "Ready"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AutoDeploy"
            },
            "true"
          ]
        }
      ]
    }
  },
  "Resources": {
    "GitHubConnection": {
      "Type": "AWS::CodeConnections::Connection",
      "Properties": {
        "ConnectionName": {
          "Fn::Sub": "${AWS::StackName}-github"
        },
        "ProviderType": "GitHub"
      }
    },
    "BuildLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      }
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "Ready",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "kairon-release",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "UpdateApplicationStack",
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:DescribeStackResources",
                    "cloudformation:GetTemplateSummary",
                    "cloudformation:CreateChangeSet",
                    "cloudformation:DescribeChangeSet",
                    "cloudformation:ExecuteChangeSet",
                    "cloudformation:DeleteChangeSet",
                    "cloudformation:ListChangeSets"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${ApplicationStack}/*"
                  }
                },
                {
                  "Sid": "TemplateChecksAndLookups",
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:ValidateTemplate",
                    "rds:DescribeDBEngineVersions",
                    "ec2:DescribeManagedPrefixLists",
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "PassOnlyToCloudFormation",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Ref": "ExecutionRoleArn"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                },
                {
                  "Sid": "PushApplicationImage",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/${RepositoryName}"
                  }
                },
                {
                  "Sid": "ReadSource",
                  "Effect": "Allow",
                  "Action": [
                    "codeconnections:UseConnection",
                    "codeconnections:GetConnectionToken",
                    "codeconnections:GetConnection",
                    "codestar-connections:UseConnection",
                    "codestar-connections:GetConnectionToken",
                    "codestar-connections:GetConnection"
                  ],
                  "Resource": {
                    "Ref": "GitHubConnection"
                  }
                },
                {
                  "Sid": "WriteBuildLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${BuildLogs.Arn}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Release": {
      "Type": "AWS::CodeBuild::Project",
      "Condition": "Ready",
      "Properties": {
        "Description": "Release main to the Kairon application stack",
        "ServiceRole": {
          "Fn::GetAtt": [
            "BuildRole",
            "Arn"
          ]
        },
        "ConcurrentBuildLimit": 1,
        "TimeoutInMinutes": 60,
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/amazonlinux-x86_64-standard:5.0",
          "PrivilegedMode": true,
          "EnvironmentVariables": [
            {
              "Name": "STACK",
              "Value": {
                "Ref": "ApplicationStack"
              }
            },
            {
              "Name": "KAIRON_CFN_ROLE_ARN",
              "Value": {
                "Ref": "ExecutionRoleArn"
              }
            },
            {
              "Name": "SCHEMA_CONFIRMED",
              "Value": "false"
            }
          ]
        },
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "BuildLogs"
            }
          }
        },
        "SourceVersion": {
          "Fn::Sub": "refs/heads/${Branch}"
        },
        "Source": {
          "Type": "GITHUB",
          "Location": {
            "Ref": "Repository"
          },
          "GitCloneDepth": 0,
          "Auth": {
            "Type": "CODECONNECTIONS",
            "Resource": {
              "Ref": "GitHubConnection"
            }
          },
          "BuildSpec": {
            "Fn::Join": [
              "\n",
              [
                "version: 0.2",
                "phases:",
                "  install:",
                "    runtime-versions:",
                "      nodejs: 22",
                "  pre_build:",
                "    commands:",
                "      - docker buildx version",
                "      - node scripts/stack-parameters.mjs \"$STACK\" > \"$CODEBUILD_SRC_DIR/../parameters.json\"",
                "      - |",
                "        set -eu",
                "        SHA=$CODEBUILD_RESOLVED_SOURCE_VERSION",
                "        deployed=$(aws cloudformation describe-stacks --stack-name \"$STACK\" --query \"Stacks[0].Parameters[?ParameterKey=='ImageTag'].ParameterValue\" --output text)",
                "        schema=\"database/ server/scripts/migrate-rds.ts server/scripts/import-rds.ts server/scripts/rds-users.ts\"",
                "        case \"$deployed\" in",
                "          git-*)",
                "            base=$(echo \"$deployed\" | cut -d- -f2)",
                "            if ! git diff --quiet \"$base\" \"$SHA\" -- $schema; then echo \"Schema files changed since $deployed. Run deploy-rds.mjs migrate by hand, then start this build again.\"; exit 1; fi ;;",
                "          *)",
                "            if [ \"$SCHEMA_CONFIRMED\" != true ]; then echo \"Deployed image $deployed was released by hand, so schema changes can't be compared. Start this build once with SCHEMA_CONFIRMED=true.\"; exit 1; fi ;;",
                "        esac",
                "  build:",
                "    commands:",
                "      - node scripts/deploy-rds.mjs release \"$STACK\" \"$CODEBUILD_SRC_DIR/../parameters.json\" \"git-$(echo $CODEBUILD_RESOLVED_SOURCE_VERSION | cut -c1-12)-$CODEBUILD_BUILD_NUMBER\"",
                "  post_build:",
                "    commands:",
                "      - |",
                "        set -eu",
                "        [ \"$CODEBUILD_BUILD_SUCCEEDING\" = 1 ]",
                "        url=$(aws cloudformation describe-stacks --stack-name \"$STACK\" --query \"Stacks[0].Outputs[?OutputKey=='ApplicationUrl'].OutputValue\" --output text)",
                "        for n in $(seq 1 20); do curl -fsS \"$url/api/health\" | grep -q '\"ok\":true' && break; sleep 15; done",
                "        curl -fsS \"$url/api/health\" | grep -q '\"ok\":true'",
                "        test \"$(curl -s -o /dev/null -w '%{http_code}' \"$url/api/state\")\" = 401",
                "        echo \"Released $CODEBUILD_RESOLVED_SOURCE_VERSION to $url\""
              ]
            ]
          }
        },
        "Triggers": {
          "Fn::If": [
            "Auto",
            {
              "Webhook": true,
              "FilterGroups": [
                [
                  {
                    "Type": "EVENT",
                    "Pattern": "PUSH"
                  },
                  {
                    "Type": "HEAD_REF",
                    "Pattern": {
                      "Fn::Sub": "^refs/heads/${Branch}$"
                    }
                  }
                ]
              ]
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "ConnectionArn": {
      "Value": {
        "Ref": "GitHubConnection"
      }
    },
    "ProjectName": {
      "Condition": "Ready",
      "Value": {
        "Ref": "Release"
      }
    }
  }
}
