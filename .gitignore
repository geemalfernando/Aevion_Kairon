# Local Vercel project metadata
.vercel/

# Dependencies and builds
node_modules/
dist/
*.tsbuildinfo

# Secrets
.env
.env.*
!.env.example

# Competition datasets must not be redistributed (Challenge Booklet · Terms and Conditions)
data/**/*.csv
data/**/*.zip
data/catalog.json

# Generated Vercel function bundle (npm --prefix server run bundle:vercel)
web/api/_server.mjs

# Leftover Flutter build output (app removed)
/mobile/

# Test reports written by npm --prefix server run test:ci
server/test-results.xml

# Generated demo seed (npm --prefix server run export:seed); contains the datasets when CSVs are present
data/seed/

# Local deployment/release files and native notification configuration
artifacts/
infra/aws/parameters.json
**/google-services.json
**/GoogleService-Info.plist
**/*service-account*.json
**/*.p8
web/ios/App/CapApp-SPM/symlinks/

# Successful one-off migration task receipts (non-secret, environment-specific)
infra/aws/parameters.json.migration.json
