# Copy to .env at the repository root. The API and seed/import scripts load it.
# `docker compose up` needs none of this: it runs its own PostgreSQL and demo accounts (see docker-compose.yml).

# ---------- Hosted (Supabase) ----------
# Setting SUPABASE_URL selects Supabase for storage and sign-in.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
PORT=8080
LOG_LEVEL=info
# Comma-separated browser origins when frontend and API are hosted separately.
# Add https://localhost for the Android app (Capacitor WebView origin).
WEB_ORIGIN=http://localhost:5173
# Set to the externally reachable API origin for proof photos on a separate frontend.
PUBLIC_API_URL=

# All four users are created by npm --prefix server run seed:users.
# Edit display names in server/seeds/users.json. Use unique emails and strong passwords.
SEED_DISPATCHER_EMAIL=
SEED_DISPATCHER_PASSWORD=
SEED_DISPATCHER_DEPOT=Peliyagoda
SEED_LOADER_EMAIL=
SEED_LOADER_PASSWORD=
SEED_LOADER_DEPOT=Peliyagoda
SEED_DRIVER_EMAIL=
SEED_DRIVER_PASSWORD=
SEED_DRIVER_DEPOT=Peliyagoda
SEED_DRIVER_VEHICLE=
SEED_STORE_EMAIL=
SEED_STORE_PASSWORD=
SEED_STORE_DEPOT=Peliyagoda
SEED_STORE_OUTLET=

# ---------- Local (no Supabase) ----------
# Leave SUPABASE_URL empty to use a local PostgreSQL and the four demo accounts (…@kairon.demo / kairon-demo).
# DATABASE_URL=postgres://kairon:kairon@localhost:5432/kairon
# AUTH_SECRET=a-long-random-string
# TOKEN_TTL_HOURS=12

# ---------- Demo (judges, local only; keep off for real use) ----------
# DEMO_MODE=true         operation clock, fleet simulation and demo reset
# SEED_DEMO_DAY=true     start with one realistic delivery day (CSVs in data/ when present, otherwise placeholders)
# VITE_DEMO_MODE=true    web build: demo dock, demo accounts on sign-in, /states
