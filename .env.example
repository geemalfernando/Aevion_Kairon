# Copy to .env at the repository root. The API and seed/import scripts load it.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
PORT=8080
LOG_LEVEL=info
# Comma-separated browser origins when frontend and API are hosted separately.
# Add https://localhost for the Android app (Capacitor WebView origin).
WEB_ORIGIN=http://localhost:5173
# Set to the externally reachable API origin for proof photos on a separate frontend.
PUBLIC_API_URL=

# All four users are created by npm --prefix server run seed:users.
# Edit display names in server/seeds/users.json. Use unique emails and strong passwords.
SEED_DISPATCHER_EMAIL=
SEED_DISPATCHER_PASSWORD=
SEED_DISPATCHER_DEPOT=Peliyagoda
SEED_LOADER_EMAIL=
SEED_LOADER_PASSWORD=
SEED_LOADER_DEPOT=Peliyagoda
SEED_DRIVER_EMAIL=
SEED_DRIVER_PASSWORD=
SEED_DRIVER_DEPOT=Peliyagoda
SEED_DRIVER_VEHICLE=
SEED_STORE_EMAIL=
SEED_STORE_PASSWORD=
SEED_STORE_DEPOT=Peliyagoda
SEED_STORE_OUTLET=
