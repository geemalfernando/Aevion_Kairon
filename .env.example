# Copy to .env and adjust. Every value has a working default for `docker compose up`.

# --- Database (PostgreSQL service in docker-compose.yml) ---
POSTGRES_USER=kairon
POSTGRES_PASSWORD=kairon
POSTGRES_DB=kairon
# Host port for inspecting the database locally (psql -h localhost -p 5433 -U kairon)
DB_PORT=5433

# --- App ---
APP_PORT=8080
# Secret for signing session tokens. Use a long random value outside local demos:  openssl rand -hex 32
AUTH_SECRET=change-me-before-deploying
# Session length in hours
TOKEN_TTL_HOURS=12
# Demo controls for judges (reset, operation clock, fleet simulation). Set false in production.
DEMO_MODE=true
# Wipe and reseed the operation on every start (the stored operation is kept when false)
RESEED_ON_BOOT=false
LOG_LEVEL=info

# --- Web app (build time) ---
# "remote" = talk to the API (set automatically in the Docker image).
# Leave unset for a standalone static build: the whole operation then runs in the browser (IndexedDB).
# VITE_API_MODE=remote
# API origin when the web app is served from a different host than the API
# VITE_API_URL=https://api.example.com
